{
  // Every rule on; only the line length is tuned to the repo's 120-character Markdown limit.
  "config": {
    "default": true,
    "MD013": { "line_length": 120, "code_block_line_length": 120, "tables": true, "headings": true }
  },
  "ignores": ["node_modules/**", "_site/**", "public/**", "themes/**"]
}
